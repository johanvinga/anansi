# Copy to server/.env and adjust. Never commit real secrets.
DATABASE_URL=postgresql://app:app@localhost:5432/supplier_app
REDIS_URL=redis://127.0.0.1:6379
# Set to true to enable asynchronous PDF analysis and its Redis worker.
CATALOG_EXTRACTION_ENABLED=false
CATALOG_OCR_LANGUAGES=eng+fra
CATALOG_EXTRACTION_MAX_PAGES=100
CATALOG_EXTRACTION_CONCURRENCY=1
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
SESSION_IDLE_MINUTES=480
UPLOAD_DIR=./storage/assets
# Cloudflare R2 (S3-compatible) storage backend. Set STORAGE_BACKEND=r2 to upload PDFs to R2 instead of local disk.
# Requires: R2_ENDPOINT (Account S3 API endpoint), R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET.
# The bucket stays private; downloads always go through the API.
STORAGE_BACKEND=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MAX_UPLOAD_MB=25
DEFAULT_CURRENCY=USD
LOGIN_RATE_LIMIT=10
APP_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
