generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  standard
}

enum AuditOutcome {
  success
  failure
}

enum CatalogAnalysisStatus {
  not_processed
  queued
  processing
  processed
  failed
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique @db.VarChar(254)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  displayName        String?   @map("display_name") @db.VarChar(100)
  role               UserRole
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions         Session[]
  auditLogs        AuditLog[]
  suppliersCreated Supplier[]      @relation("SupplierCreatedBy")
  assetsUploaded   SupplierAsset[] @relation("AssetUploadedBy")
  catalogsUploaded Catalog[]       @relation("CatalogUploadedBy")

  @@map("users")
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(200)
  /// Lowercased name; enforces case-insensitive uniqueness (FR-SUP-08).
  nameKey     String   @unique @map("name_key") @db.VarChar(200)
  street      String?  @db.VarChar(200)
  city        String?  @db.VarChar(100)
  stateRegion String?  @map("state_region") @db.VarChar(100)
  postalCode  String?  @map("postal_code") @db.VarChar(20)
  country     String?  @db.VarChar(100)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy  User?              @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  categories SupplierCategory[]
  assets     SupplierAsset[]
  catalogs   Catalog[]
  products   Product[]

  @@map("suppliers")
}

enum AttributeDataType {
  text
  number
  decimal
  boolean
  date
  select
}

model AttributeSet {
  id        String   @id @default(uuid()) @db.Uuid
  nameEn    String   @map("name_en") @db.VarChar(100)
  nameFr    String   @map("name_fr") @db.VarChar(100)
  /// Lowercased English name; enforces case-insensitive uniqueness (FR-ATS-01, FR-I18N-07).
  nameKey   String   @unique @map("name_key") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  fields   AttributeField[]
  products Product[]

  @@map("attribute_sets")
}

model AttributeField {
  id             String            @id @default(uuid()) @db.Uuid
  attributeSetId String            @map("attribute_set_id") @db.Uuid
  nameEn         String            @map("name_en") @db.VarChar(100)
  nameFr         String            @map("name_fr") @db.VarChar(100)
  code           String            @db.VarChar(100)
  dataType       AttributeDataType @map("data_type")
  unit           String?           @db.VarChar(20)
  isRequired     Boolean           @default(false) @map("is_required")
  isArchived     Boolean           @default(false) @map("is_archived")
  sortOrder      Int               @map("sort_order")

  attributeSet AttributeSet            @relation(fields: [attributeSetId], references: [id], onDelete: Restrict)
  options      AttributeOption[]
  values       ProductAttributeValue[]

  @@unique([attributeSetId, code])
  @@index([attributeSetId, sortOrder])
  @@map("attribute_fields")
}

model AttributeOption {
  id               String @id @default(uuid()) @db.Uuid
  attributeFieldId String @map("attribute_field_id") @db.Uuid
  labelEn          String @map("label_en") @db.VarChar(100)
  labelFr          String @map("label_fr") @db.VarChar(100)
  sortOrder        Int    @map("sort_order")

  field  AttributeField          @relation(fields: [attributeFieldId], references: [id], onDelete: Cascade)
  values ProductAttributeValue[]

  @@unique([attributeFieldId, labelEn])
  @@map("attribute_options")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  nameEn         String   @map("name_en") @db.VarChar(200)
  nameFr         String   @map("name_fr") @db.VarChar(200)
  descriptionEn  String?  @map("description_en") @db.Text
  descriptionFr  String?  @map("description_fr") @db.Text
  supplierSku    String   @map("supplier_sku") @db.VarChar(100)
  /// Lowercased SKU; enforces per-supplier case-insensitive uniqueness (FR-PRD-03).
  skuKey         String   @map("sku_key") @db.VarChar(100)
  minQuantity    Int      @map("min_quantity")
  cost           Decimal  @db.Decimal(12, 2)
  currency       String   @db.Char(3)
  attributeSetId String?  @map("attribute_set_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier     Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  attributeSet AttributeSet?           @relation(fields: [attributeSetId], references: [id], onDelete: Restrict)
  values       ProductAttributeValue[]
  categories   ProductCategory[]

  @@unique([supplierId, skuKey])
  @@index([supplierId])
  @@index([nameEn])
  @@map("products")
}

model ProductAttributeValue {
  productId        String    @map("product_id") @db.Uuid
  attributeFieldId String    @map("attribute_field_id") @db.Uuid
  valueText        String?   @map("value_text") @db.Text
  valueNumber      Decimal?  @map("value_number") @db.Decimal(18, 4)
  valueBoolean     Boolean?  @map("value_boolean")
  valueDate        DateTime? @map("value_date") @db.Date
  optionId         String?   @map("option_id") @db.Uuid

  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  field   AttributeField   @relation(fields: [attributeFieldId], references: [id], onDelete: Restrict)
  option  AttributeOption? @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([productId, attributeFieldId])
  @@index([attributeFieldId])
  @@map("product_attribute_values")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  nameEn    String   @map("name_en") @db.VarChar(100)
  nameFr    String   @map("name_fr") @db.VarChar(100)
  /// Lowercased English name; enforces case-insensitive uniqueness (FR-I18N-07).
  nameKey   String   @unique @map("name_key") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  suppliers SupplierCategory[]
  products  ProductCategory[]
  catalogs  CatalogCategory[]

  @@map("categories")
}

model SupplierCategory {
  supplierId String @map("supplier_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([supplierId, categoryId])
  @@index([categoryId])
  @@map("supplier_categories")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model CatalogCategory {
  catalogId  String @map("catalog_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  catalog    Catalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([catalogId, categoryId])
  @@index([categoryId])
  @@map("catalog_categories")
}

model SupplierAsset {
  id               String   @id @default(uuid()) @db.Uuid
  supplierId       String   @map("supplier_id") @db.Uuid
  originalFileName String   @map("original_file_name") @db.VarChar(255)
  storageKey       String   @unique @map("storage_key") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  sizeBytes        BigInt   @map("size_bytes")
  title            String?  @db.VarChar(200)
  description      String?  @db.Text
  uploadedById     String?  @map("uploaded_by_id") @db.Uuid
  uploaderId       String?  @map("uploader_id") @db.Uuid
  uploaderName     String?  @map("uploader_name") @db.VarChar(254)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("AssetUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@map("supplier_assets")
}

/// A supplier price/product catalog stored as a PDF file (FR-CLG).
model Catalog {
  id               String   @id @default(uuid()) @db.Uuid
  supplierId       String?  @map("supplier_id") @db.Uuid
  name             String   @db.VarChar(200)
  /// Optional since FR-CLG-01 was relaxed at the user's request (2026-11-08).
  version          String?  @db.VarChar(50)
  originalFileName String   @map("original_file_name") @db.VarChar(255)
  storageKey       String   @unique @map("storage_key") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  /// File size in bytes; read-only after upload.
  sizeBytes        BigInt   @map("size_bytes")
  uploadedById     String?  @map("uploaded_by_id") @db.Uuid
  analysisStatus   CatalogAnalysisStatus @default(not_processed) @map("analysis_status")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  uploadedBy User?    @relation("CatalogUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  extractionJobs CatalogExtractionJob[]
  categories CatalogCategory[]

  @@index([supplierId])
  @@index([analysisStatus])
  @@map("catalogs")
}

model CatalogExtractionJob {
  id                 String                @id @default(uuid()) @db.Uuid
  catalogId          String                @map("catalog_id") @db.Uuid
  status             CatalogAnalysisStatus @default(queued)
  stage              String                @default("queued") @db.VarChar(50)
  progress           Int                   @default(0)
  currentPage        Int                   @default(0) @map("current_page")
  totalPages         Int                   @default(0) @map("total_pages")
  productsIdentified Int                   @default(0) @map("products_identified")
  processingError    String?               @map("processing_error") @db.Text
  results            Json?
  startedAt          DateTime?             @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?             @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@index([catalogId, createdAt])
  @@index([status, createdAt])
  @@map("catalog_extraction_jobs")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          String       @id @default(uuid()) @db.Uuid
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId String?      @map("actor_user_id") @db.Uuid
  actorEmail  String       @map("actor_email") @db.VarChar(254)
  action      String       @db.VarChar(50)
  outcome     AuditOutcome
  entityType  String?      @map("entity_type") @db.VarChar(50)
  entityId    String?      @map("entity_id") @db.VarChar(64)
  changes     Json?
  ipAddress   String?      @map("ip_address") @db.VarChar(45)
  requestId   String       @map("request_id") @db.VarChar(64)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId])
  @@index([action, occurredAt])
  @@map("audit_logs")
}
