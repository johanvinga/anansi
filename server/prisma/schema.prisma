generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  standard
}

enum AuditOutcome {
  success
  failure
}

enum CatalogAnalysisStatus {
  not_processed
  queued
  processing
  /// Supplier metadata analysis completed; category (tags) analysis has not.
  metadata_only
  processed
  failed
}

enum CatalogAnalysisPrompt {
  supplier
  tags
}

enum PinnedItemType {
  catalog
  supplier
  product
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique @db.VarChar(254)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  displayName        String?   @map("display_name") @db.VarChar(100)
  role               UserRole
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions         Session[]
  auditLogs        AuditLog[]
  suppliersCreated Supplier[]      @relation("SupplierCreatedBy")
  assetsUploaded   SupplierAsset[] @relation("AssetUploadedBy")
  catalogsUploaded Catalog[]       @relation("CatalogUploadedBy")
  pinnedItems      PinnedItem[]
  sentShares       SharedItem[]     @relation("SharedItemSender")
  receivedShares   SharedItem[]     @relation("SharedItemRecipient")

  @@map("users")
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(200)
  /// Lowercased name; enforces case-insensitive uniqueness (FR-SUP-08).
  nameKey     String   @unique @map("name_key") @db.VarChar(200)
  street      String?  @db.VarChar(200)
  city        String?  @db.VarChar(100)
  stateRegion String?  @map("state_region") @db.VarChar(100)
  postalCode  String?  @map("postal_code") @db.VarChar(20)
  country     String?  @db.VarChar(100)
  website     String?  @db.VarChar(500)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy  User?              @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contacts   SupplierContact[]
  tags       SupplierTag[]
  assets     SupplierAsset[]
  catalogs   Catalog[]
  products   Product[]

  @@map("suppliers")
}

model SupplierContact {
  id          String   @id @default(uuid()) @db.Uuid
  supplierId  String   @map("supplier_id") @db.Uuid
  firstName   String?  @map("first_name") @db.VarChar(100)
  lastName    String?  @map("last_name") @db.VarChar(100)
  email       String?  @db.VarChar(254)
  phoneNumber String?  @map("phone_number") @db.VarChar(50)
  weChatId    String?  @map("wechat_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, createdAt(sort: Desc), id(sort: Desc)], map: "supplier_contacts_supplier_order_idx")
  @@map("supplier_contacts")
}

enum AttributeDataType {
  text
  number
  decimal
  boolean
  date
  select
}

model AttributeSet {
  id        String   @id @default(uuid()) @db.Uuid
  nameEn    String   @map("name_en") @db.VarChar(100)
  nameFr    String   @map("name_fr") @db.VarChar(100)
  /// Lowercased English name; enforces case-insensitive uniqueness (FR-ATS-01, FR-I18N-07).
  nameKey   String   @unique @map("name_key") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  fields   AttributeField[]
  sharedFields AttributeSetField[]
  products Product[]

  @@map("attribute_sets")
}

model AttributeField {
  id             String            @id @default(uuid()) @db.Uuid
  attributeSetId String?           @map("attribute_set_id") @db.Uuid
  nameEn         String            @map("name_en") @db.VarChar(100)
  nameFr         String            @map("name_fr") @db.VarChar(100)
  code           String            @db.VarChar(100)
  dataType       AttributeDataType @map("data_type")
  unit           String?           @db.VarChar(20)
  isRequired     Boolean           @default(false) @map("is_required")
  isArchived     Boolean           @default(false) @map("is_archived")
  sortOrder      Int               @map("sort_order")

  attributeSet AttributeSet?           @relation(fields: [attributeSetId], references: [id], onDelete: Restrict)
  options      AttributeOption[]
  values       ProductAttributeValue[]
  sets         AttributeSetField[]

  @@unique([attributeSetId, code])
  @@index([attributeSetId, sortOrder])
  @@map("attribute_fields")
}

model AttributeSetField {
  attributeSetId String @map("attribute_set_id") @db.Uuid
  attributeFieldId String @map("attribute_field_id") @db.Uuid
  isRequired Boolean @default(false) @map("is_required")
  isArchived Boolean @default(false) @map("is_archived")
  sortOrder Int @map("sort_order")

  attributeSet AttributeSet @relation(fields: [attributeSetId], references: [id], onDelete: Cascade)
  field AttributeField @relation(fields: [attributeFieldId], references: [id], onDelete: Restrict)

  @@id([attributeSetId, attributeFieldId])
  @@index([attributeFieldId])
  @@map("attribute_set_fields")
}

model AttributeOption {
  id               String @id @default(uuid()) @db.Uuid
  attributeFieldId String @map("attribute_field_id") @db.Uuid
  labelEn          String @map("label_en") @db.VarChar(100)
  labelFr          String @map("label_fr") @db.VarChar(100)
  sortOrder        Int    @map("sort_order")

  field  AttributeField          @relation(fields: [attributeFieldId], references: [id], onDelete: Cascade)
  values ProductAttributeValue[]

  @@unique([attributeFieldId, labelEn])
  @@map("attribute_options")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  nameEn         String   @map("name_en") @db.VarChar(200)
  nameFr         String   @map("name_fr") @db.VarChar(200)
  productTypeEn  String?  @map("product_type_en") @db.VarChar(100)
  productTypeFr  String?  @map("product_type_fr") @db.VarChar(100)
  descriptionEn  String?  @map("description_en") @db.Text
  descriptionFr  String?  @map("description_fr") @db.Text
  supplierSku    String   @map("supplier_sku") @db.VarChar(100)
  /// Lowercased SKU; enforces per-supplier case-insensitive uniqueness (FR-PRD-03).
  skuKey         String   @map("sku_key") @db.VarChar(100)
  minQuantity    Int?     @map("min_quantity")
  cost           Decimal? @db.Decimal(12, 2)
  currency       String?  @db.Char(3)
  attributeSetId String?  @map("attribute_set_id") @db.Uuid
  sourceCatalogId String?  @map("source_catalog_id") @db.Uuid
  sourcePageNumbers Int[]  @default([]) @map("source_page_numbers")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier     Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  attributeSet AttributeSet?           @relation(fields: [attributeSetId], references: [id], onDelete: Restrict)
  sourceCatalog Catalog?                @relation(fields: [sourceCatalogId], references: [id], onDelete: SetNull)
  values       ProductAttributeValue[]
  tags         ProductTag[]
  image        ProductImage?

  @@unique([supplierId, skuKey])
  @@index([supplierId])
  @@index([sourceCatalogId])
  @@index([nameEn])
  @@map("products")
}

model ProductImage {
  productId  String  @id @map("product_id") @db.Uuid
  storageKey String  @unique @map("storage_key") @db.VarChar(255)
  mimeType   String  @map("mime_type") @db.VarChar(100)
  sizeBytes  Int     @map("size_bytes")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model StoredFileCleanup {
  storageKey String   @id @map("storage_key") @db.VarChar(255)
  availableAt DateTime @map("available_at") @db.Timestamptz(6)

  @@index([availableAt])
  @@map("stored_file_cleanup")
}

model ProductAttributeValue {
  productId        String    @map("product_id") @db.Uuid
  attributeFieldId String    @map("attribute_field_id") @db.Uuid
  valueText        String?   @map("value_text") @db.Text
  valueNumber      Decimal?  @map("value_number") @db.Decimal(18, 4)
  valueBoolean     Boolean?  @map("value_boolean")
  valueDate        DateTime? @map("value_date") @db.Date
  optionId         String?   @map("option_id") @db.Uuid

  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  field   AttributeField   @relation(fields: [attributeFieldId], references: [id], onDelete: Restrict)
  option  AttributeOption? @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([productId, attributeFieldId])
  @@index([attributeFieldId])
  @@map("product_attribute_values")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  nameEn    String   @map("name_en") @db.VarChar(100)
  nameFr    String   @map("name_fr") @db.VarChar(100)
  nameKey   String   @unique @map("name_key") @db.VarChar(100)
  isArchived Boolean @default(false) @map("is_archived")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products  ProductTag[]
  catalogs  CatalogTag[]
  suppliers SupplierTag[]

  @@map("tags")
}

model ProductTag {
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

model CatalogTag {
  catalogId String @map("catalog_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([catalogId, tagId])
  @@index([tagId])
  @@map("catalog_tags")
}

model SupplierTag {
  supplierId String @map("supplier_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([supplierId, tagId])
  @@index([tagId])
  @@map("supplier_tags")
}

model SupplierAsset {
  id               String   @id @default(uuid()) @db.Uuid
  supplierId       String   @map("supplier_id") @db.Uuid
  originalFileName String   @map("original_file_name") @db.VarChar(255)
  storageKey       String   @unique @map("storage_key") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  sizeBytes        BigInt   @map("size_bytes")
  title            String?  @db.VarChar(200)
  description      String?  @db.Text
  uploadedById     String?  @map("uploaded_by_id") @db.Uuid
  uploaderId       String?  @map("uploader_id") @db.Uuid
  uploaderName     String?  @map("uploader_name") @db.VarChar(254)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("AssetUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@map("supplier_assets")
}

/// A supplier price/product catalog stored as a PDF file (FR-CLG).
model Catalog {
  id               String   @id @default(uuid()) @db.Uuid
  supplierId       String?  @map("supplier_id") @db.Uuid
  name             String   @db.VarChar(200)
  /// Optional since FR-CLG-01 was relaxed at the user's request (2026-11-08).
  version          String?  @db.VarChar(50)
  originalFileName String   @map("original_file_name") @db.VarChar(255)
  storageKey       String   @unique @map("storage_key") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  /// File size in bytes; read-only after upload.
  sizeBytes        BigInt   @map("size_bytes")
  uploadedById     String?  @map("uploaded_by_id") @db.Uuid
  uploadIdempotencyKey String? @map("upload_idempotency_key") @db.VarChar(128)
  uploadRequestHash String? @map("upload_request_hash") @db.Char(64)
  analysisStatus   CatalogAnalysisStatus @default(not_processed) @map("analysis_status")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  uploadedBy User?    @relation("CatalogUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  extractionJobs CatalogExtractionJob[]
  tags        CatalogTag[]
  sourcedProducts Product[]

  @@unique([uploadedById, uploadIdempotencyKey])
  @@index([supplierId])
  @@index([analysisStatus])
  @@map("catalogs")
}

model CatalogExtractionJob {
  id                 String                @id @default(uuid()) @db.Uuid
  catalogId          String                @map("catalog_id") @db.Uuid
  prompt             CatalogAnalysisPrompt @default(supplier)
  status             CatalogAnalysisStatus @default(queued)
  stage              String                @default("queued") @db.VarChar(50)
  progress           Int                   @default(0)
  currentPage        Int                   @default(0) @map("current_page")
  totalPages         Int                   @default(0) @map("total_pages")
  productsIdentified Int                   @default(0) @map("products_identified")
  processingError    String?               @map("processing_error") @db.Text
  results            Json?
  startedAt          DateTime?             @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?             @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  images  CatalogImageCandidate[]

  @@index([catalogId, createdAt])
  @@index([status, createdAt])
  @@map("catalog_extraction_jobs")
}

model CatalogImageCandidate {
  id         String               @id @default(uuid()) @db.Uuid
  jobId      String               @map("job_id") @db.Uuid
  storageKey String               @unique @map("storage_key") @db.VarChar(255)
  pageNumber Int                  @map("page_number")
  mimeType   String               @map("mime_type") @db.VarChar(100)
  sizeBytes  Int                  @map("size_bytes")
  job        CatalogExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, pageNumber])
  @@map("catalog_image_candidates")
}

model PinnedItem {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  itemType  PinnedItemType @map("item_type")
  itemId    String         @map("item_id") @db.Uuid
  pinnedAt  DateTime       @default(now()) @map("pinned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId, pinnedAt(sort: Desc)])
  @@map("pinned_items")
}

model SharedItem {
  id        String         @id @default(uuid()) @db.Uuid
  senderId  String         @map("sender_id") @db.Uuid
  recipientId String       @map("recipient_id") @db.Uuid
  itemType  PinnedItemType @map("item_type")
  itemId    String         @map("item_id") @db.Uuid
  note      String?        @db.VarChar(500)
  hiddenByRecipient Boolean @default(false) @map("hidden_by_recipient")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  sender    User @relation("SharedItemSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("SharedItemRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId, itemType, itemId])
  @@index([recipientId, hiddenByRecipient, updatedAt(sort: Desc)])
  @@index([senderId, updatedAt(sort: Desc)])
  @@index([itemType, itemId])
  @@map("shared_items")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          String       @id @default(uuid()) @db.Uuid
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId String?      @map("actor_user_id") @db.Uuid
  actorEmail  String       @map("actor_email") @db.VarChar(254)
  action      String       @db.VarChar(50)
  outcome     AuditOutcome
  entityType  String?      @map("entity_type") @db.VarChar(50)
  entityId    String?      @map("entity_id") @db.VarChar(64)
  changes     Json?
  ipAddress   String?      @map("ip_address") @db.VarChar(45)
  requestId   String       @map("request_id") @db.VarChar(64)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId])
  @@index([action, occurredAt])
  @@map("audit_logs")
}
